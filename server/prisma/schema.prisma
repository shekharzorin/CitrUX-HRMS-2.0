// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  status       String @default("ACTIVE") // ACTIVE, INACTIVE
  role         String @default("EMPLOYEE") // ADMIN, HR, EMPLOYEE, INTERN

  // Hierarchy
  managerId    String?
  manager      User?   @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[]  @relation("ManagerSubordinates")

  shiftId     String?
  shift       Shift?       @relation("UserShift", fields: [shiftId], references: [id])
  offboarding Offboarding?

  profile       Profile?
  attendance    Attendance[]
  onboarding    Onboarding?
  salary        SalaryStructure?
  payslips      Payslip[]
  certificates  Certificate[]
  goals         Goal[]
  reviews       PerformanceReview[]
  reviewsGiven  PerformanceReview[] @relation("Reviewer")
  expenses      ExpenseClaim[]
  assets        Asset[]
  notifications Notification[]

  // Leaves
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
}

// ... existing models ...

model SalaryStructure {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id])
  basic      Float
  hra        Float
  da         Float  @default(0)
  allowances Float  @default(0)
  deductions Float  @default(0)
  ctc        Float // Calculated
}

model Payslip {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  month       Int
  year        Int
  url         String? // Optional now as we generate dynamic
  gross       Float
  net         Float
  details     String // JSON Snapshot of calculations
  generatedAt DateTime @default(now())
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phone          String?
  designation    String?
  department     String?
  employmentType String    @default("FULL_TIME") // FULL_TIME, INTERN, CONTRACT
  dateOfJoining  DateTime?
  documents      String? // JSON
}

model Attendance {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  date     DateTime // YYYY-MM-DD
  checkIn  DateTime?
  checkOut DateTime?
  location String?
  hours    Float?

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])
  status  String  @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  isLate  Boolean @default(false)
  breaks  Break[]

  @@unique([userId, date])
}

model Shift {
  id         String       @id @default(uuid())
  name       String // "General", "Morning"
  startTime  String // "09:00"
  endTime    String // "18:00"
  graceTime  Int          @default(15) // Minutes
  attendance Attendance[]
  users      User[]       @relation("UserShift")
}

model Break {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  startTime    DateTime
  endTime      DateTime?
  duration     Float? // in minutes
}

// --- LEAVE MANAGEMENT ---

model LeaveType {
  id           String         @id @default(uuid())
  name         String // CL, SL, PL
  code         String         @unique // cl, sl
  daysPerYear  Int
  carryForward Boolean        @default(false)
  balances     LeaveBalance[]
  requests     LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  balance     Float
  used        Float     @default(0)

  @@unique([userId, leaveTypeId])
}

model LeaveRequest {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  managerComment String?
  createdAt      DateTime  @default(now())
}

model Holiday {
  id   String   @id @default(uuid())
  name String
  date DateTime @unique
  type String // MANDATORY, OPTIONAL
}

model Onboarding {
  id          String           @id @default(uuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id])
  status      String           @default("PENDING")
  documents   String?
  bankDetails String?
  submittedAt DateTime         @default(now())
  tasks       OnboardingTask[]
}

model OnboardingTask {
  id           String     @id @default(uuid())
  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id])
  title        String
  status       String     @default("PENDING") // PENDING, COMPLETED
  completedAt  DateTime?
}

model Offboarding {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  reason        String
  status        String         @default("PENDING") // PENDING, APPROVED, REJECTED, CLEARED
  lastDay       DateTime
  createdAt     DateTime       @default(now())
  exitInterview ExitInterview?
}

model ExitInterview {
  id            String      @id @default(uuid())
  offboardingId String      @unique
  offboarding   Offboarding @relation(fields: [offboardingId], references: [id])
  feedback      String
  rating        Int
  submittedAt   DateTime    @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  deadline    DateTime
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
}

model PerformanceReview {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  period     String // e.g., "Q4 2024"
  rating     Int // 1-5
  feedback   String
  createdAt  DateTime @default(now())
}

model JobPosting {
  id           String           @id @default(uuid())
  title        String
  department   String
  description  String
  status       String           @default("OPEN") // OPEN, CLOSED
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id            String     @id @default(uuid())
  jobId         String
  job           JobPosting @relation(fields: [jobId], references: [id])
  applicantName String
  email         String
  phone         String
  resumeUrl     String? // Link to stored resume
  status        String     @default("NEW") // NEW, INTERVIEW, OFFERED, REJECTED, HIRED
  appliedAt     DateTime   @default(now())
}

model ExpenseCategory {
  id     String         @id @default(uuid())
  name   String         @unique
  limit  Float? // Optional cap
  claims ExpenseClaim[]
}

model ExpenseClaim {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Float
  description String
  status      String          @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  receiptUrl  String?
  date        DateTime
  createdAt   DateTime        @default(now())
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String
  title          String
  verificationId String   @unique
  issuedDate     DateTime @default(now())
  url            String?
}

model Asset {
  id           String    @id @default(uuid())
  name         String
  type         String // LAPTOP, PHONE, LICENSE, FURNITURE
  serialNumber String?   @unique
  status       String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, DAMAGED, LOST
  assignedTo   String?
  user         User?     @relation(fields: [assignedTo], references: [id])
  purchasedAt  DateTime?
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}
