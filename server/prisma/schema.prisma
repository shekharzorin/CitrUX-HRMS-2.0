  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id          String    @id @default(uuid())
