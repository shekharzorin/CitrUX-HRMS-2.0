generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}


model Company {
  id               String            @id @default(uuid())
  name             String            @unique
  subdomain        String?           @unique
  domain           String?
  plan             String            @default("STARTER")
  logoUrl          String?
  slogan           String?           @default("Citrux SaaS")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  profiles         Profile[]
  workLogs         WorkLog[]
  tasks            Task[]
  shifts           Shift[]           @relation("CompanyShifts")
  attendancePolicy AttendancePolicy? @relation("CompanyAttendancePolicy")
}


model User {
  id            String              @id @default(uuid())
  employeeId    String?             @unique
  email         String              @unique
  passwordHash  String
  resetToken    String?
  resetTokenExpiry DateTime?
  status        String              @default("ACTIVE")
  role          Role                @default(EMPLOYEE)
  managerId     String?
  shiftId       String?
  companyId     String?
  company       Company?            @relation(fields: [companyId], references: [id])
  
  assets              Asset[]
  attendance          Attendance[]
  certificates        Certificate[]
  expenses            ExpenseClaim[]
  goals               Goal[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  notifications       Notification[]
  encashments         LeaveEncashment[]
  documents           UserDocument[]
  offboarding         Offboarding?
  onboarding          Onboarding?
  payslips            Payslip[]
  reviewsGiven        PerformanceReview[] @relation("Reviewer")
  reviews             PerformanceReview[]
  profile             Profile?
  salary              SalaryStructure?
  shift               Shift?              @relation("UserShift", fields: [shiftId], references: [id])
  manager             User?               @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates        User[]              @relation("ManagerSubordinates")
  timesheets          Timesheet[]
  workLogs            WorkLog[]
  tasks               Task[]
  attendanceRequests  AttendanceRequest[]
  audits              AuditLog[]          @relation("UserAudits")
  policyOverride      UserPolicyOverride?
}


model SalaryStructure {
  id              String @id @default(uuid())
  userId          String @unique
  basic           Float
  hra             Float
  da              Float  @default(0)
  allowances      Float  @default(0)
  
  // Deductions
  pf              Float  @default(0) // Provident Fund
  esi             Float  @default(0) // Employee State Insurance
  professionalTax Float  @default(0)
  deductions      Float  @default(0) // Other Deductions
  
  ctc             Float
  user            User   @relation(fields: [userId], references: [id])
}

model Payslip {
  id          String   @id @default(uuid())
  userId      String
  month       Int
  year        Int
  url         String?
  
  // Earnings Snapshot
  gross       Float
  net         Float
  
  // Attendance Snapshot
  totalDays   Int      @default(30)
  workingDays Int      @default(0)
  presentDays Float    @default(0)
  lopDays     Float    @default(0) // Loss of Pay Days
  
  // Deductions Snapshot
  pfAmount    Float    @default(0)
  esiAmount   Float    @default(0)
  taxAmount   Float    @default(0)
  
  details     String   // Full JSON breakdown
  status      String   @default("GENERATED") // GENERATED, PAID
  paymentDate DateTime?
  
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  emergencyContact String?
  designation    String?
  department     String?
  employmentType String    @default("FULL_TIME")
  dateOfJoining  DateTime?
  dob            DateTime?
  documents      String?
  
  // Bank Details
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  
  // Identity
  aadhaarNumber  String?
  panNumber      String?
  uanNumber      String?

  profilePhoto   String?
  profilePhotoSettings String? // JSON string for zoom/position
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id       String    @id @default(uuid())
  userId   String
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  location String?
  hours    Float?
  shiftId  String?
  status   String    @default("PRESENT")
  isLate   Boolean   @default(false)
  shift    Shift?    @relation(fields: [shiftId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  breaks   Break[]

  @@unique([userId, date])
}

model Shift {
  id             String               @id @default(uuid())
  name           String
  startTime      String               // "HH:MM" 24-hr
  endTime        String               // "HH:MM" 24-hr
  graceTime      Int                  @default(15)
  isNightShift   Boolean              @default(false)  // crosses midnight
  isDefault      Boolean              @default(false)  // fallback shift for the company
  companyId      String?
  company        Company?             @relation("CompanyShifts", fields: [companyId], references: [id])
  attendance     Attendance[]
  users          User[]               @relation("UserShift")
  policyOverride ShiftPolicyOverride?
}

// ─── Attendance Policy (one per company) ──────────────────────────────────────
model AttendancePolicy {
  id                            String   @id @default(uuid())
  companyId                     String   @unique
  company                       Company  @relation("CompanyAttendancePolicy", fields: [companyId], references: [id])

  // General
  graceMinutes                  Int      @default(10)
  halfDayThresholdHours         Float    @default(4.0)
  fullDayHours                  Float    @default(8.0)
  maxWorkHoursPerDay            Float    @default(12.0)
  allowMultipleSessions         Boolean  @default(false)

  // Auto Clock-Out
  autoClockOutEnabled           Boolean  @default(true)
  autoClockOutType              String   @default("SHIFT_END") // "SHIFT_END" | "HOURS_BASED"
  autoClockOutBufferMinutes     Int      @default(30)
  autoClockOutMaxHours          Float    @default(12.0)

  // Break Policy
  allowBreaks                   Boolean  @default(true)
  maxBreaksPerDay               Int      @default(3)
  maxTotalBreakMinutes          Int      @default(60)
  autoEndBreakOnCheckout        Boolean  @default(true)
  autoEndBreakAfterMinutes      Int      @default(60)

  // Missed Punch Handling
  missedPunchAutoResolve        Boolean  @default(false)
  missedPunchAction             String   @default("MARK_ABSENT") // "AUTO_CHECKOUT" | "MARK_HALF_DAY" | "MARK_ABSENT"
  missedPunchNotifyAfterMinutes Int      @default(60)

  // Late & Penalty
  markLateAfterMinutes          Int      @default(15)
  lateCountThresholdForHalfDay  Int      @default(3)
  absentIfNoPunchInAfterHours   Float    @default(6.0)

  // Approval Rules
  allowEmployeeAdjustment       Boolean  @default(true)
  maxPastDaysForAdjustment      Int      @default(7)
  requireApproval               Boolean  @default(true)

  // Security / Geo-fence
  requireGeoFence               Boolean  @default(false)
  allowedRadiusMeters           Int      @default(100)

  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

// ─── Shift-level policy overrides ────────────────────────────────────────────
model ShiftPolicyOverride {
  id                        String   @id @default(uuid())
  shiftId                   String   @unique
  shift                     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  graceMinutes              Int?
  halfDayThresholdHours     Float?
  fullDayHours              Float?
  maxWorkHoursPerDay        Float?
  autoClockOutEnabled       Boolean?
  autoClockOutBufferMinutes Int?
  autoClockOutMaxHours      Float?
  allowBreaks               Boolean?
  maxBreaksPerDay           Int?
  maxTotalBreakMinutes      Int?

  updatedAt                 DateTime @updatedAt
}

// ─── User-level policy overrides (most granular) ──────────────────────────────
model UserPolicyOverride {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  graceMinutes          Int?
  halfDayThresholdHours Float?
  fullDayHours          Float?
  maxWorkHoursPerDay    Float?
  requireGeoFence       Boolean?
  allowedRadiusMeters   Int?

  updatedAt             DateTime @updatedAt
}

model Break {
  id           String     @id @default(uuid())
  attendanceId String
  startTime    DateTime
  endTime      DateTime?
  duration     Float?
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
}

model LeaveType {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique
  daysPerYear  Int
  carryForward Boolean        @default(false)
  maxCarryForward Int         @default(0) // Max days to carry over
  balances     LeaveBalance[]
  requests     LeaveRequest[]
  encashments  LeaveEncashment[]
}

model LeaveEncashment {
  id          String    @id @default(uuid())
  userId      String
  leaveTypeId String
  days        Float
  amount      Float     @default(0)
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reason      String?
  managerComment String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation(fields: [userId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
}

model LeaveBalance {
  id          String    @id @default(uuid())
  userId      String
  leaveTypeId String
  balance     Float
  used        Float     @default(0)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, leaveTypeId])
}

model LeaveRequest {
  id             String    @id @default(uuid())
  userId         String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String
  status         String    @default("PENDING")
  managerComment String?
  createdAt      DateTime  @default(now())
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
}

model Holiday {
  id   String   @id @default(uuid())
  name String
  date DateTime @unique
  type String
}

model Onboarding {
  id             String           @id @default(uuid())
  userId         String           @unique
  status         String           @default("DRAFT") // DRAFT, SUBMITTED, PENDING_VERIFICATION, APPROVED, REJECTED
  
  // Step 1: Personal
  fullName       String?
  fatherName     String?
  motherName     String?
  guardianName   String?
  dateOfBirth    DateTime?
  gender         String?
  maritalStatus  String?
  bloodGroup     String?
  nationality    String?
  profilePhoto   String?
  profilePhotoSettings String? // JSON string for zoom/position

  // Step 2: Contact
  personalMobile String?
  officialMobile String?
  personalEmail  String?
  officialEmail  String?
  currentAddress String?
  permanentAddress String?
  sameAsCurrentAddress Boolean @default(false)
  emergencyContacts OnboardingEmergencyContact[]

  // Step 3: Employment
  department     String?
  designation    String?
  employmentType String?
  dateOfJoining  DateTime?
  workLocation   String?
  reportingManagerId String?
  shift          String?
  workingHours   String?
  probationPeriodMonths Int?
  noticePeriodDays Int?
  
  // Step 4: Work Experience
  experiences    OnboardingExperience[]
  totalYearsExperience Float?

  // Step 5: Education
  education      OnboardingEducation[]

  // Step 6: Identity
  aadhaarNumber  String?
  panNumber      String?
  passportNumber String?
  uanNumber      String?
  esicNumber     String?
  drivingLicense String?

  // Step 7: Bank
  accountHolderName String?
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  branchName     String?
  salaryPaymentMode String?

  // Step 8: Health
  medicalConditions String?
  allergies      String?
  disabilityStatus Boolean?
  disabilityDetails String?

  // Step 9: Documents
  documents      OnboardingDocument[]

  // Step 10: System Access
  companyEmailCreated Boolean @default(false)
  hrmsAccessEnabled   Boolean @default(false)
  roleAndPermissions  String?
  deviceIssued        String?
  assetId             String?

  // Step 11: Policies
  companyPolicyAccepted Boolean @default(false)
  ndaAccepted           Boolean @default(false)
  codeOfConductAccepted Boolean @default(false)
  digitalConsentSignature String?
  acceptanceTimestamp   DateTime?
  acceptanceIp          String?

  submittedAt    DateTime?
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id])
}

model OnboardingEmergencyContact {
  id           String     @id @default(uuid())
  onboardingId String
  name         String
  relationship String?
  mobile       String
  alternateMobile String?
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model OnboardingExperience {
  id           String     @id @default(uuid())
  onboardingId String
  companyName  String
  designation  String?
  employmentType String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean    @default(false)
  reasonForLeaving String?
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model OnboardingEducation {
  id           String     @id @default(uuid())
  onboardingId String
  institutionName String
  degreeOrCourse String
  highestQualification String?
  yearOfPassing Int?
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model OnboardingDocument {
  id           String     @id @default(uuid())
  onboardingId String
  type         String // aadhaar_card, pan_card, resume, etc.
  url          String
  status       String     @default("PENDING")
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model Offboarding {
  id            String         @id @default(uuid())
  userId        String         @unique
  reason        String
  status        String         @default("PENDING")
  lastDay       DateTime
  createdAt     DateTime       @default(now())
  exitInterview ExitInterview?
  user          User           @relation(fields: [userId], references: [id])
}

model ExitInterview {
  id            String      @id @default(uuid())
  offboardingId String      @unique
  feedback      String
  rating        Int
  submittedAt   DateTime    @default(now())
  offboarding   Offboarding @relation(fields: [offboardingId], references: [id])
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  deadline    DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model PerformanceReview {
  id         String   @id @default(uuid())
  userId     String
  reviewerId String
  period     String
  rating     Int
  feedback   String
  createdAt  DateTime @default(now())
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model JobPosting {
  id           String           @id @default(uuid())
  title        String
  department   String
  description  String
  status       String           @default("OPEN")
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id            String     @id @default(uuid())
  jobId         String
  applicantName String
  email         String
  phone         String
  resumeUrl     String?
  status        String     @default("NEW")
  appliedAt     DateTime   @default(now())
  job           JobPosting @relation(fields: [jobId], references: [id])
}

model ExpenseCategory {
  id     String         @id @default(uuid())
  name   String         @unique
  limit  Float?
  claims ExpenseClaim[]
}

model ExpenseClaim {
  id          String          @id @default(uuid())
  userId      String
  categoryId  String
  amount      Float
  description String
  status      String          @default("PENDING")
  receiptUrl  String?
  date        DateTime
  createdAt   DateTime        @default(now())
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  type           String
  title          String
  verificationId String   @unique
  issuedDate     DateTime @default(now())
  url            String?
  user           User     @relation(fields: [userId], references: [id])
}

model Asset {
  id           String    @id @default(uuid())
  name         String
  type         String
  serialNumber String?   @unique
  status       String    @default("AVAILABLE")
  assignedTo   String?
  purchasedAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [assignedTo], references: [id])
}

model UserDocument {
  id          String    @id @default(uuid())
  userId      String
  type        String    // PASSPORT, VISA, ID_PROOF, AGREEMENT, OTHER
  name        String
  url         String
  expiryDate  DateTime?
  status      String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedBy  String?
  uploadedAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String   @default("INFO") // INFO, LEAVE, TASK, SYSTEM
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model JobRole {
  id          String   @id @default(uuid())
  title       String   @unique
  department  String?
  level       Int      @default(0) // 0=lowest, higher number = higher rank
  description String?
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key   String @id
  value String
}

model Timesheet {
  id        String           @id @default(uuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  status    String           @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  entries   TimesheetEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  taskId      String?
  taskName    String?   // Allow free text or linked task
  project     String?   // Snapshot of project/client name
  mon         Float     @default(0)
  tue         Float     @default(0)
  wed         Float     @default(0)
  thu         Float     @default(0)
  fri         Float     @default(0)
  sat         Float     @default(0)
  sun         Float     @default(0)
  total       Float     @default(0)
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id])
}

model Task {
  id          String           @id @default(uuid())
  userId      String?
  title       String
  description String?
  project     String?
  status      String           @default("TODO") // TODO, IN_PROGRESS, DONE
  priority    String           @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate     DateTime?
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  entries     TimesheetEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id])
}

model WorkLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime
  hoursWorked Float
  breakTime   Float    @default(0) // in minutes
  description String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model AttendanceRequest {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime
  clockIn        DateTime
  clockOut       DateTime
  reason         String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  managerComment String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g., ATTENDANCE_OVERRIDE, USER_UPDATE
  entityType  String   // e.g., ATTENDANCE
  entityId    String
  details     String   // JSON string of changes (old vs new)
  performedBy String
  createdAt   DateTime @default(now())
  
  actor       User     @relation("UserAudits", fields: [performedBy], references: [id])
}

model SystemError {
  id        String   @id @default(uuid())
  module    String   // e.g., "AUTH", "PAYROLL", "DATABASE"
  severity  String   // "INFO", "WARNING", "CRITICAL"
  message   String
  stack     String?
  timestamp DateTime @default(now())
  resolved  Boolean  @default(false)
}

model ModuleHealth {
  id        String   @id @default(uuid())
  module    String   @unique
  status    String   // "HEALTHY", "DEGRADED", "DOWN"
  lastChecked DateTime @default(now())
  details   String?  // JSON details
}
