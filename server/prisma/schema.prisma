generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator client_default {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                String            @id @default(uuid())
  name              String            @unique
  subdomain         String?           @unique
  domain            String?
  plan              String            @default("STARTER")
  logoUrl           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  status            String            @default("ACTIVE")
  slogan            String?           @default("Citrux SaaS")
  logoMediumUrl     String?
  logoThumbnailUrl  String?
  faviconUrl        String?
  // Leave accrual policy chosen by the company admin:
  //   MANUAL  → balances are managed manually (no automatic crediting) [default]
  //   MONTHLY → credit daysPerYear/12 to each active employee on the 1st of each month
  //   ANNUAL  → credit the full daysPerYear on Jan 1
  leaveAccrualMode  String            @default("MANUAL")
  assets            Asset[]
  branches          Branch[]
  departments       Department[]
  attendancePolicy  AttendancePolicy? @relation("CompanyAttendancePolicy")
  expenseCategories ExpenseCategory[]
  holidays          Holiday[]
  jobPostings       JobPosting[]
  jobRoles          JobRole[]
  leaveTypes        LeaveType[]
  profiles          Profile[]
  shifts            Shift[]           @relation("CompanyShifts")
  tasks             Task[]
  users             User[]
  workLogs          WorkLog[]
  recognitions      Recognition[]
  accessRoles       AccessRole[]
  tickets            Ticket[]
  supportDepartments SupportDepartment[]
  ticketCategories   TicketCategory[]
  attendanceSources  AttendanceSource[]  @relation("CompanyAttendanceSources")
  geofences          Geofence[]          @relation("CompanyGeofences")
}

model User {
  id                   String              @id @default(uuid())
  employeeId           String?             @unique
  email                String              @unique
  passwordHash         String
  resetToken           String?
  resetTokenExpiry     DateTime?
  refreshToken         String?
  refreshTokenExpiry   DateTime?
  status               String              @default("ACTIVE")
  role                 Role                @default(EMPLOYEE)
  // Per-tenant dynamic role (RBAC v2). Nullable during migration: when null,
  // authorization falls back to the legacy `role` enum + static permission map.
  accessRoleId         String?
  managerId            String?
  shiftId              String?
  companyId            String?
  assets               Asset[]
  attendance           Attendance[]
  attendanceEvents     AttendanceEvent[]   @relation("UserAttendanceEvents")
  attendanceRequests   AttendanceRequest[]
  audits               AuditLog[]          @relation("UserAudits")
  certificates         Certificate[]
  expenses             ExpenseClaim[]
  goals                Goal[]
  leaveBalances        LeaveBalance[]
  encashments          LeaveEncashment[]
  leaveRequests        LeaveRequest[]
  notifications        Notification[]
  offboarding          Offboarding?
  onboarding           Onboarding?
  payslips             Payslip[]
  reviewsGiven         PerformanceReview[] @relation("Reviewer")
  reviews              PerformanceReview[]
  profile              Profile?
  salary               SalaryStructure?
  tasks                Task[]              @relation("AssignedTasks")
  createdTasks         Task[]              @relation("CreatedTasks")
  recognitionsReceived Recognition[]       @relation("RecognitionsReceived")
  recognitionsGiven    Recognition[]       @relation("RecognitionsGiven")
  timesheets           Timesheet[]
  company              Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager              User?               @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: Cascade)
  subordinates         User[]              @relation("ManagerSubordinates")
  shift                Shift?              @relation("UserShift", fields: [shiftId], references: [id], onDelete: Cascade)
  documents            UserDocument[]      @relation("DocumentOwner")
  uploadedDocs         UserDocument[]      @relation("Uploader")
  policyOverride       UserPolicyOverride?
  workLogs             WorkLog[]
  accessRole           AccessRole?         @relation(fields: [accessRoleId], references: [id])
  // Support Desk (Phase 1) back-relations
  ticketsRequested          Ticket[]            @relation("TicketRequester")
  ticketsAssigned           Ticket[]            @relation("TicketAssignee")
  ticketComments            TicketComment[]     @relation("TicketCommentAuthor")
  ticketAttachmentsUploaded TicketAttachment[]  @relation("TicketAttachmentUploader")
  ticketActivities          TicketActivity[]    @relation("TicketActivityActor")
  ticketWatching            TicketWatcher[]     @relation("TicketWatcher")
  ticketAssignmentsTo       TicketAssignment[]  @relation("TicketAssignedTo")
  ticketAssignmentsBy       TicketAssignment[]  @relation("TicketAssignedBy")
  supportQueuesOwned        SupportDepartment[] @relation("QueueDefaultAssignee")
}

// ── RBAC v2: per-tenant dynamic roles ────────────────────────────────────────
// A company-scoped, named bundle of permissions. Distinct from the legacy `Role`
// enum (platform-fixed) and from `JobRole` (HR designation/title).
model AccessRole {
  id          String                 @id @default(uuid())
  name        String
  description String?
  companyId   String
  isSystem    Boolean                @default(false) // seeded default; cannot be deleted
  isOwner     Boolean                @default(false) // protected owner role; always all permissions
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions AccessRolePermission[]
  users       User[]
  supportQueueRoles SupportQueueRole[]

  @@unique([companyId, name])
}

model AccessRolePermission {
  id           String     @id @default(uuid())
  accessRoleId String
  permission   String // matches the code-defined permission catalog
  accessRole   AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  @@unique([accessRoleId, permission])
}

// ═══════════════════════════ Support Desk (Phase 1) ═══════════════════════════
// Operational ticketing domain. Distinct from HRMS Department (org structure):
// tickets route to SupportDepartment (admin-created queues). All tenant-scoped.

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  WEB
  MOBILE
  EMAIL
  WHATSAPP
  SLACK
  TEAMS
  SYSTEM
  AI_AGENT
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
  ADMIN_ONLY
}

enum SlaStatus {
  NONE
  ON_TRACK
  AT_RISK
  BREACHED
  PAUSED
}

enum AiProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum AssignmentType {
  MANUAL
  AUTO
  AI
  ROUND_ROBIN
  ESCALATION
}

enum WatcherType {
  MANUAL
  AUTO
  MENTION
  DEPARTMENT
}

enum TicketRelationType {
  DUPLICATES
  RELATED
  BLOCKS
  PARENT_CHILD
  INCIDENT_LINK
}

enum SupportQueueVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  CATEGORY_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  AI_CATEGORIZED
  REOPENED
  SLA_BREACHED
  DELETED
  RESTORED
  WATCHER_ADDED
  WATCHER_REMOVED
  MENTIONED
  LINKED
  UNLINKED
}

// Admin-created operational queue (IT, HR, Facilities…). The ticket routing target.
model SupportDepartment {
  id                String                 @id @default(uuid())
  companyId         String
  name              String
  description       String?
  icon              String?
  color             String?
  isActive          Boolean                @default(true)
  isSystem          Boolean                @default(false) // seeded default queue; cannot be deleted
  defaultAssigneeId String?
  visibility        SupportQueueVisibility @default(PUBLIC)
  sortOrder         Int                    @default(0)
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultAssignee   User?                  @relation("QueueDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  categories        TicketCategory[]
  tickets           Ticket[]
  visibleToRoles    SupportQueueRole[]

  @@unique([companyId, name])
  @@index([companyId, isActive, sortOrder])
}

// Role-based queue visibility (only meaningful when visibility = RESTRICTED).
model SupportQueueRole {
  id                  String            @id @default(uuid())
  supportDepartmentId String
  accessRoleId        String
  supportDepartment   SupportDepartment @relation(fields: [supportDepartmentId], references: [id], onDelete: Cascade)
  accessRole          AccessRole        @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  @@unique([supportDepartmentId, accessRoleId])
}

// Optional secondary classification, scoped under a SupportDepartment.
model TicketCategory {
  id                  String            @id @default(uuid())
  companyId           String
  supportDepartmentId String
  name                String
  description         String?
  isActive            Boolean           @default(true)
  deletedAt           DateTime?
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supportDepartment   SupportDepartment @relation(fields: [supportDepartmentId], references: [id], onDelete: Cascade)
  tickets             Ticket[]

  @@unique([supportDepartmentId, name])
}

model Ticket {
  id                  String             @id @default(uuid())
  ticketNumber        Int
  companyId           String
  subject             String
  description         String
  status              TicketStatus       @default(OPEN)
  priority            TicketPriority     @default(MEDIUM)
  source              TicketSource       @default(WEB)
  requesterId         String
  assigneeId          String?
  supportDepartmentId String?
  categoryId          String?
  // Searchability (FTS GIN index added later via raw SQL — §12)
  normalizedTitle     String?
  searchableContent   String?
  tags                String[]           @default([])
  // AI lifecycle
  aiStatus            AiProcessingStatus @default(PENDING)
  aiCategorized       Boolean            @default(false)
  aiConfidence        Float?
  // SLA-compatible fields (no logic in Phase 1)
  firstResponseAt     DateTime?
  dueAt               DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  slaStatus           SlaStatus          @default(NONE)
  // Soft delete
  deletedAt           DateTime?
  deletedById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester         User                 @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee          User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  supportDepartment SupportDepartment?   @relation(fields: [supportDepartmentId], references: [id])
  category          TicketCategory?      @relation(fields: [categoryId], references: [id])
  comments          TicketComment[]
  attachments       TicketAttachment[]
  activities        TicketActivity[]
  watchers          TicketWatcher[]
  assignmentHistory TicketAssignment[]
  relationsFrom     TicketRelationship[] @relation("TicketRelSource")
  relationsTo       TicketRelationship[] @relation("TicketRelTarget")
  aiJobs            AiJob[]

  @@unique([companyId, ticketNumber])
  @@index([companyId, status, deletedAt])
  @@index([companyId, assigneeId])
  @@index([companyId, supportDepartmentId, status])
}

model TicketComment {
  id          String            @id @default(uuid())
  ticketId    String
  authorId    String
  body        String
  visibility  CommentVisibility @default(PUBLIC)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
}

model TicketAttachment {
  id           String    @id @default(uuid())
  ticketId     String
  commentId    String?
  uploadedById String
  fileName     String
  url          String
  fileType     String
  fileSize     Int
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([ticketId])
}

// Unified activity timeline / audit (every meaningful change appends a row).
model TicketActivity {
  id        String             @id @default(uuid())
  ticketId  String
  type      TicketActivityType
  actorId   String?
  data      String?
  createdAt DateTime           @default(now())
  ticket    Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?              @relation("TicketActivityActor", fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

// Followers: manual, auto, mention-based, future department.
model TicketWatcher {
  id        String      @id @default(uuid())
  ticketId  String
  userId    String
  type      WatcherType @default(MANUAL)
  addedById String?
  createdAt DateTime    @default(now())
  ticket    Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User        @relation("TicketWatcher", fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([ticketId])
}

// Assignment history chain (Ticket.assigneeId stays the current assignee).
model TicketAssignment {
  id             String         @id @default(uuid())
  ticketId       String
  assignedToId   String
  assignedById   String?
  assignmentType AssignmentType @default(MANUAL)
  reason         String?
  assignedAt     DateTime       @default(now())
  unassignedAt   DateTime?
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTo     User           @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  assignedBy     User?          @relation("TicketAssignedBy", fields: [assignedById], references: [id])

  @@index([ticketId])
}

// Ticket-to-ticket relationships — FUTURE-READY (schema only, no endpoints in Phase 1).
model TicketRelationship {
  id          String             @id @default(uuid())
  companyId   String
  sourceId    String
  targetId    String
  type        TicketRelationType
  createdById String?
  createdAt   DateTime           @default(now())
  source      Ticket             @relation("TicketRelSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target      Ticket             @relation("TicketRelTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
}

// AI job audit trail (powers retries/idempotency + lifecycle).
model AiJob {
  id          String             @id @default(uuid())
  ticketId    String?
  type        String
  triggerType String             @default("AUTO") // AUTO = initial routing on create; MANUAL = agent reprocess (cooldown applies)
  provider    String?
  status      AiProcessingStatus @default(PENDING)
  inputHash   String?
  output      String?
  confidence  Float?
  error       String?
  createdAt   DateTime           @default(now())
  completedAt DateTime?
  ticket      Ticket?            @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SalaryStructure {
  id              String @id @default(uuid())
  userId          String @unique
  basic           Float
  hra             Float
  da              Float  @default(0)
  allowances      Float  @default(0)
  pf              Float  @default(0)
  esi             Float  @default(0)
  professionalTax Float  @default(0)
  deductions      Float  @default(0)
  ctc             Float
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payslip {
  id          String    @id @default(uuid())
  userId      String
  month       Int
  year        Int
  url         String?
  gross       Float
  net         Float
  totalDays   Int       @default(30)
  workingDays Int       @default(0)
  presentDays Float     @default(0)
  lopDays     Float     @default(0)
  pfAmount    Float     @default(0)
  esiAmount   Float     @default(0)
  taxAmount   Float     @default(0)
  details     String
  status      String    @default("GENERATED")
  paymentDate DateTime?
  generatedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                        String      @id @default(uuid())
  userId                    String      @unique
  firstName                 String
  lastName                  String
  phone                     String?
  address                   String?
  emergencyContact          String?
  designation               String?
  department                String?
  branchId                  String?
  departmentId              String?
  employmentType            String      @default("FULL_TIME")
  dateOfJoining             DateTime?
  dob                       DateTime?
  documents                 String?
  bankName                  String?
  accountNumber             String?
  ifscCode                  String?
  bankBranch                String?
  bankAddress               String?
  paymentMode               String?     @default("BANK_TRANSFER")
  aadhaarNumber             String?
  panNumber                 String?
  uanNumber                 String?
  nationality               String?
  bloodGroup                String?
  gender                    String?
  maritalStatus             String?
  presentAddress            String?
  permanentAddress          String?
  emergencyContactName      String?
  emergencyContactRelation  String?
  emergencyContactPhone     String?
  emergencyContactAlternate String?
  emergencyContactAddress   String?
  profilePhoto              String?
  profilePhotoSettings      String?
  companyId                 String?
  profilePhotoMediumUrl     String?
  profilePhotoThumbnailUrl  String?
  company                   Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch                    Branch?     @relation(fields: [branchId], references: [id])
  departmentRef             Department? @relation(fields: [departmentId], references: [id])
}

model Attendance {
  id       String    @id @default(uuid())
  userId   String
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  location String?
  hours    Float?
  shiftId  String?
  status   String    @default("PRESENT")
  isLate   Boolean   @default(false)
  // Attendance Management Framework: when true, this daily row is a projection of
  // AttendanceEvents (not a direct web-portal punch). primarySourceId = the source
  // that produced it. Additive; legacy rows keep generatedFromEvents=false.
  generatedFromEvents Boolean @default(false)
  primarySourceId     String?
  shift    Shift?    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks   Break[]

  @@unique([userId, date])
}

// Append-only raw punches from any attendance source (the "truth" layer). The
// daily Attendance row above is computed from these by the calculation engine.
enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

model AttendanceEvent {
  id                 String              @id @default(uuid())
  companyId          String
  userId             String
  sourceId           String?
  eventType          AttendanceEventType
  timestamp          DateTime            // when the punch happened (UTC)
  businessDate       DateTime            // UTC midnight — matches Attendance.date
  verificationMethod String?             // source type label, e.g. MANUAL / CSV_IMPORT
  dedupKey           String              // idempotency: re-imports/retries upsert
  status             String              @default("ACCEPTED") // ACCEPTED | QUARANTINED | VOIDED
  note               String?
  selfieUrl          String?             // selfie evidence (Cloudinary URL)
  selfieStatus       String?             // CAPTURED (future: VERIFIED | REJECTED | EXPIRED) — no verification logic yet
  locationData       Json?
  rawPayload         Json?
  ingestedVia        String?
  createdById        String?             // user who recorded it (manual/import)
  createdAt          DateTime            @default(now())
  user               User                @relation("UserAttendanceEvents", fields: [userId], references: [id], onDelete: Cascade)
  source             AttendanceSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([companyId, dedupKey])
  @@index([companyId, userId, businessDate])
  @@index([sourceId])
}

// ── Attendance Management Framework ──────────────────────────────────────────
// AttendanceSource = an admin-configured attendance method for a company (one of
// many: biometric, mobile GPS, QR, CSV, etc.). This is the config layer; the
// event/projection layers (AttendanceEvent → Attendance) are added in later slices.
enum AttendanceSourceType {
  BIOMETRIC_ZKTECO
  BIOMETRIC_ESSL
  BIOMETRIC_MATRIX
  BIOMETRIC_GENERIC
  MOBILE_GPS
  QR
  RFID_NFC
  WEBCAM
  MANUAL
  CSV_IMPORT
  EXTERNAL_API
  WEB_PORTAL
}

enum AttendanceIngestionMode {
  WEBHOOK
  PULL_SYNC
  IMPORT
  DIRECT
}

enum AttendanceSourceHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  ERROR
}

model AttendanceSource {
  id            String                  @id @default(uuid())
  companyId     String
  name          String
  type          AttendanceSourceType
  ingestionMode AttendanceIngestionMode
  configuration Json                    @default("{}")
  isActive      Boolean                 @default(true)
  priority      Int                     @default(0)
  healthStatus  AttendanceSourceHealth  @default(UNKNOWN)
  lastSyncAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  company       Company                 @relation("CompanyAttendanceSources", fields: [companyId], references: [id], onDelete: Cascade)
  events        AttendanceEvent[]

  @@index([companyId, isActive])
}

// Geofence = an admin-defined allowed location for GPS attendance (circle: center
// + radius). MOBILE_GPS sources can require a check-in to fall inside one.
model Geofence {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  centerLat    Float
  centerLng    Float
  radiusMeters Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation("CompanyGeofences", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
}

model Shift {
  id             String               @id @default(uuid())
  name           String
  startTime      String
  endTime        String
  graceTime      Int                  @default(15)
  companyId      String?
  isDefault      Boolean              @default(false)
  isNightShift   Boolean              @default(false)
  attendance     Attendance[]
  company        Company?             @relation("CompanyShifts", fields: [companyId], references: [id], onDelete: Cascade)
  policyOverride ShiftPolicyOverride?
  users          User[]               @relation("UserShift")
}

model AttendancePolicy {
  id                            String   @id @default(uuid())
  companyId                     String   @unique
  graceMinutes                  Int      @default(10)
  halfDayThresholdHours         Float    @default(4.0)
  fullDayHours                  Float    @default(8.0)
  maxWorkHoursPerDay            Float    @default(12.0)
  allowMultipleSessions         Boolean  @default(false)
  autoClockOutEnabled           Boolean  @default(true)
  autoClockOutType              String   @default("SHIFT_END")
  autoClockOutBufferMinutes     Int      @default(30)
  autoClockOutMaxHours          Float    @default(12.0)
  allowBreaks                   Boolean  @default(true)
  maxBreaksPerDay               Int      @default(3)
  maxTotalBreakMinutes          Int      @default(60)
  autoEndBreakOnCheckout        Boolean  @default(true)
  autoEndBreakAfterMinutes      Int      @default(60)
  missedPunchAutoResolve        Boolean  @default(false)
  missedPunchAction             String   @default("MARK_ABSENT")
  missedPunchNotifyAfterMinutes Int      @default(60)
  markLateAfterMinutes          Int      @default(15)
  lateCountThresholdForHalfDay  Int      @default(3)
  absentIfNoPunchInAfterHours   Float    @default(6.0)
  allowEmployeeAdjustment       Boolean  @default(true)
  maxPastDaysForAdjustment      Int      @default(7)
  requireApproval               Boolean  @default(true)
  requireGeoFence               Boolean  @default(false)
  allowedRadiusMeters           Int      @default(100)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  company                       Company  @relation("CompanyAttendancePolicy", fields: [companyId], references: [id], onDelete: Cascade)
}

model ShiftPolicyOverride {
  id                        String   @id @default(uuid())
  shiftId                   String   @unique
  graceMinutes              Int?
  halfDayThresholdHours     Float?
  fullDayHours              Float?
  maxWorkHoursPerDay        Float?
  autoClockOutEnabled       Boolean?
  autoClockOutBufferMinutes Int?
  autoClockOutMaxHours      Float?
  allowBreaks               Boolean?
  maxBreaksPerDay           Int?
  maxTotalBreakMinutes      Int?
  updatedAt                 DateTime @updatedAt
  shift                     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model UserPolicyOverride {
  id                    String   @id @default(uuid())
  userId                String   @unique
  graceMinutes          Int?
  halfDayThresholdHours Float?
  fullDayHours          Float?
  maxWorkHoursPerDay    Float?
  requireGeoFence       Boolean?
  allowedRadiusMeters   Int?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Break {
  id           String     @id @default(uuid())
  attendanceId String
  startTime    DateTime
  endTime      DateTime?
  duration     Float?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
}

model LeaveType {
  id              String            @id @default(uuid())
  name            String
  code            String
  daysPerYear     Int
  carryForward    Boolean           @default(false)
  maxCarryForward Int               @default(0)
  isPaid          Boolean           @default(true) // Payroll Core: paid vs unpaid (LOP) leave. Default true preserves legacy behavior until admins classify types.
  companyId       String?
  balances        LeaveBalance[]
  encashments     LeaveEncashment[]
  requests        LeaveRequest[]
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([code, companyId])
}

model LeaveEncashment {
  id             String    @id @default(uuid())
  userId         String
  leaveTypeId    String
  days           Float
  amount         Float     @default(0)
