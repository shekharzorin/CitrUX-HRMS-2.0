generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(uuid())
  employeeId    String?             @unique
  email         String              @unique
  passwordHash  String
  status        String              @default("ACTIVE")
  role          String              @default("EMPLOYEE")
  managerId     String?
  shiftId       String?
  assets        Asset[]
  attendance    Attendance[]
  certificates  Certificate[]
  expenses      ExpenseClaim[]
  goals         Goal[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  notifications Notification[]
  offboarding   Offboarding?
  onboarding    Onboarding?
  payslips      Payslip[]
  reviewsGiven  PerformanceReview[] @relation("Reviewer")
  reviews       PerformanceReview[]
  profile       Profile?
  salary        SalaryStructure?
  shift         Shift?              @relation("UserShift", fields: [shiftId], references: [id])
  manager       User?               @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates  User[]              @relation("ManagerSubordinates")
  timesheets    Timesheet[]
}

model SalaryStructure {
  id         String @id @default(uuid())
  userId     String @unique
  basic      Float
  hra        Float
  da         Float  @default(0)
  allowances Float  @default(0)
  deductions Float  @default(0)
  ctc        Float
  user       User   @relation(fields: [userId], references: [id])
}

model Payslip {
  id          String   @id @default(uuid())
  userId      String
  month       Int
  year        Int
  url         String?
  gross       Float
  net         Float
  details     String
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  firstName      String
  lastName       String
  phone          String?
  designation    String?
  department     String?
  employmentType String    @default("FULL_TIME")
  dateOfJoining  DateTime?
  documents      String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id       String    @id @default(uuid())
  userId   String
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  location String?
  hours    Float?
  shiftId  String?
  status   String    @default("PRESENT")
  isLate   Boolean   @default(false)
  shift    Shift?    @relation(fields: [shiftId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  breaks   Break[]

  @@unique([userId, date])
}

model Shift {
  id         String       @id @default(uuid())
  name       String
  startTime  String
  endTime    String
  graceTime  Int          @default(15)
  attendance Attendance[]
  users      User[]       @relation("UserShift")
}

model Break {
  id           String     @id @default(uuid())
  attendanceId String
  startTime    DateTime
  endTime      DateTime?
  duration     Float?
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
}

model LeaveType {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique
  daysPerYear  Int
  carryForward Boolean        @default(false)
  balances     LeaveBalance[]
  requests     LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(uuid())
  userId      String
  leaveTypeId String
  balance     Float
  used        Float     @default(0)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, leaveTypeId])
}

model LeaveRequest {
  id             String    @id @default(uuid())
  userId         String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String
  status         String    @default("PENDING")
  managerComment String?
  createdAt      DateTime  @default(now())
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
}

model Holiday {
  id   String   @id @default(uuid())
  name String
  date DateTime @unique
  type String
}

model Onboarding {
  id             String           @id @default(uuid())
  userId         String           @unique
  status         String           @default("PENDING")
  firstName      String?
  lastName       String?
  fatherName     String?
  dateOfBirth    DateTime?
  currAddress    String?
  permAddress    String?
  aadhaarNumber  String?
  panNumber      String?
  aadhaarUrl     String?
  panUrl         String?
  passbookUrl    String?
  offerLetterUrl String?
  documents      String?
  educationDocumentsUrl String?
  experienceDocumentsUrl String?
  bankDetails    String?
  submittedAt    DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id])
  tasks          OnboardingTask[]
}

model OnboardingTask {
  id           String     @id @default(uuid())
  onboardingId String
  title        String
  status       String     @default("PENDING")
  completedAt  DateTime?
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id])
}

model Offboarding {
  id            String         @id @default(uuid())
  userId        String         @unique
  reason        String
  status        String         @default("PENDING")
  lastDay       DateTime
  createdAt     DateTime       @default(now())
  exitInterview ExitInterview?
  user          User           @relation(fields: [userId], references: [id])
}

model ExitInterview {
  id            String      @id @default(uuid())
  offboardingId String      @unique
  feedback      String
  rating        Int
  submittedAt   DateTime    @default(now())
  offboarding   Offboarding @relation(fields: [offboardingId], references: [id])
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  deadline    DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model PerformanceReview {
  id         String   @id @default(uuid())
  userId     String
  reviewerId String
  period     String
  rating     Int
  feedback   String
  createdAt  DateTime @default(now())
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model JobPosting {
  id           String           @id @default(uuid())
  title        String
  department   String
  description  String
  status       String           @default("OPEN")
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id            String     @id @default(uuid())
  jobId         String
  applicantName String
  email         String
  phone         String
  resumeUrl     String?
  status        String     @default("NEW")
  appliedAt     DateTime   @default(now())
  job           JobPosting @relation(fields: [jobId], references: [id])
}

model ExpenseCategory {
  id     String         @id @default(uuid())
  name   String         @unique
  limit  Float?
  claims ExpenseClaim[]
}

model ExpenseClaim {
  id          String          @id @default(uuid())
  userId      String
  categoryId  String
  amount      Float
  description String
  status      String          @default("PENDING")
  receiptUrl  String?
  date        DateTime
  createdAt   DateTime        @default(now())
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  type           String
  title          String
  verificationId String   @unique
  issuedDate     DateTime @default(now())
  url            String?
  user           User     @relation(fields: [userId], references: [id])
}

model Asset {
  id           String    @id @default(uuid())
  name         String
  type         String
  serialNumber String?   @unique
  status       String    @default("AVAILABLE")
  assignedTo   String?
  purchasedAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [assignedTo], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model JobRole {
  id          String   @id @default(uuid())
  title       String   @unique
  department  String?
  level       Int      @default(0) // 0=lowest, higher number = higher rank
  description String?
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key   String @id
  value String
}

model Timesheet {
  id        String           @id @default(uuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  status    String           @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  entries   TimesheetEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  taskId      String?
  taskName    String?   // Allow free text or linked task
  project     String?   // Snapshot of project/client name
  mon         Float     @default(0)
  tue         Float     @default(0)
  wed         Float     @default(0)
  thu         Float     @default(0)
  fri         Float     @default(0)
  sat         Float     @default(0)
  sun         Float     @default(0)
  total       Float     @default(0)
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id])
}

model Task {
  id          String           @id @default(uuid())
  title       String
  description String?
  project     String?
  status      String           @default("ACTIVE")
  entries     TimesheetEntry[]
  createdAt   DateTime         @default(now())
}
